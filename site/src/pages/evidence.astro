---
import Base from '../layouts/Base.astro'
import regression from '../data/regression.json'
import tool from '../data/tool_results.json'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

interface Result {
  name: string
  kind: string
  says: string
  status: string
  seconds: number
  found_by?: string
  detail?: Record<string, unknown>
  mutation?: string
}
const results = regression.results as Result[]
const regs = results.filter((r) => r.kind === 'regression')
const claims = results.filter((r) => r.kind === 'claim')

// Group by the module prefix in each test name, which is also how the suite is organised.
const area = (n: string) => {
  const k = n.split('-')[0]
  return (
    {
      zk: 'Zero-knowledge proofs',
      tardos: 'Fingerprint codes',
      envelope: 'The envelope (layer P1)',
      membrane: 'The membrane (layer P2)',
      authorship: 'Authorship provenance',
      chaff: 'The chaff layer',
      render: 'The chaff layer',
      kerning: 'The detector',
      trace: 'End-to-end tracing',
    }[k] ?? k
  )
}
const areas = [...new Set(results.map((r) => area(r.name)))]
---

<Base
  title="Evidence — CLOISTER"
  description="Every claim CLOISTER makes, the named test that checks it, and the raw JSON the suite wrote. Includes the nine bugs that measurement found, and the three that writing the test suite found."
  wide
>
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-8">
    <p class="font-mono text-[11.5px] uppercase tracking-[0.22em] text-amber-400/90 mb-4">
      {regression.passed}/{regression.total} passing · {regression.seconds}s ·
      regenerated by CI, not typed in
    </p>
    <h1
      class="text-[2.1rem] sm:text-[2.7rem] leading-[1.1] font-semibold tracking-[-0.02em] text-slate-300"
    >
      Every number here has a test behind it.
    </h1>
    <p class="mt-6 max-w-3xl text-[15px] leading-relaxed text-slate-400">
      Security claims are cheap to write and expensive to check. So each one on this site
      is a named test, and each bug measurement turned up is a{' '}
      <em>regression test that carries its own bug</em>: it registers the fix and a faithful
      reconstruction of the original broken code, and asserts the broken one fails. If the
      broken version passes, the test reports{' '}
      <span class="font-mono text-amber-400">TOOTHLESS</span> and the run fails — because a
      regression test its own bug would have passed protects nothing.
    </p>
  </section>

  <!-- ------------------------------------------------------------- summary -->
  <section class="mx-auto max-w-6xl px-5">
    <div class="grid sm:grid-cols-4 gap-x-8 gap-y-6 py-7 border-y border-ink-700/60">
      {
        [
          { v: `${regression.passed}/${regression.total}`, l: 'tests passing' },
          { v: String(claims.length), l: 'measured claims' },
          { v: String(regs.length), l: 'regression tests, each with its bug attached' },
          {
            v: String(
              regression.failed.length + regression.toothless.length +
                (regression.leaky?.length ?? 0),
            ),
            l: 'failing, toothless or leaky',
          },
        ].map((k) => (
          <div>
            <div class="font-mono text-[1.75rem] leading-none tabnum text-amber-400">
              {k.v}
            </div>
            <div class="mt-2 text-[12.5px] text-slate-400 leading-snug">{k.l}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ------------------------------------------------------------- headline -->
  <section class="mx-auto max-w-6xl px-5 mt-14">
    <h2 class="text-[13px] uppercase tracking-[0.16em] text-slate-400">
      Headline measurements
    </h2>
    <div class="rule mt-4 mb-6"></div>
    <div class="overflow-x-auto">
      <table class="w-full text-[13px]">
        <tbody class="divide-y divide-ink-700/50">
          {
            [
              [
                'Distinctive source terms in any copy’s text layer',
                `${tool.leakage.distinctive_terms_leaked} of ${tool.leakage.distinctive_terms_in_source}`,
                'good',
              ],
              [
                'Numeric strings leaked',
                `${tool.leakage.numeric_strings_leaked} of ${tool.leakage.numeric_strings_in_source}`,
                'good',
              ],
              [
                'Traced correctly from one photographed page',
                `${tool.tracing_from_one_photographed_page.correct} of ${tool.tracing_from_one_photographed_page.trials}`,
                'good',
              ],
              [
                'False accusations across a 40-person roster',
                String(tool.tracing_from_one_photographed_page.false_accusations),
                'good',
              ],
              [
                'Worst score margin over the nearest innocent',
                String(tool.tracing_from_one_photographed_page.margin_over_nearest_innocent.min),
                'neutral',
              ],
              [
                'Codeword coverage per copy (8-page memorandum)',
                `${tool.scale_test.codeword_coverage}×`,
                'neutral',
              ],
              [
                'OCR of the rendered page recovers the document',
                'yes — the format layer is a cost, not a barrier',
                'bad',
              ],
            ].map(([label, value, tone]) => (
              <tr>
                <td class="py-2.5 pr-6 text-slate-400">{label}</td>
                <td
                  class={`py-2.5 font-mono tabnum whitespace-nowrap ${
                    tone === 'good'
                      ? 'text-emerald-400'
                      : tone === 'bad'
                        ? 'text-rose-400'
                        : 'text-slate-300'
                  }`}
                >
                  {value}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ------------------------------------------------------------- bugs found -->
  <section class="mx-auto max-w-6xl px-5 mt-16" id="found">
    <h2 class="text-[13px] uppercase tracking-[0.16em] text-slate-400">
      Bugs measurement found, and what caught each one
    </h2>
    <div class="rule mt-4 mb-6"></div>
    <p class="max-w-3xl text-[13.5px] leading-relaxed text-slate-400 mb-7">
      Every one of these was a security property that was silently false while the code
      looked correct and the tests were green. The interesting column is the last one: not
      what broke, but what exercised it — because in every case the reason nothing caught it
      earlier was that nothing tried.
    </p>
    <div class="space-y-3.5">
      {
        regs.map((r) => (
          <details class="panel rounded-lg group">
            <summary class="px-5 py-3.5 cursor-pointer flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
              <span class="font-mono text-[12.5px] text-amber-400">{r.name}</span>
              <span class="text-[11px] text-slate-400 ml-auto whitespace-nowrap">
                {r.status === 'pass' ? 'passing · mutation reproduces the bug' : r.status}
              </span>
            </summary>
            <div class="px-5 pb-5 space-y-3">
              <p class="text-[13px] leading-relaxed text-slate-400 max-w-4xl">{r.says}</p>
              {r.found_by && (
                <p class="text-[12.5px] leading-relaxed text-slate-300 border-l-2 border-amber-400/60 pl-3">
                  <span class="text-slate-400">Found by:</span> {r.found_by}
                </p>
              )}
              {r.detail && Object.keys(r.detail).length > 0 && (
                <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-1 text-[12px] font-mono pt-1">
                  {Object.entries(r.detail).map(([k, v]) => (
                    <div class="flex gap-2 min-w-0">
                      <dt class="text-slate-400 shrink-0">{k}</dt>
                      <dd class="text-slate-300 truncate">{String(v)}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ------------------------------------------------------------- all claims -->
  <section class="mx-auto max-w-6xl px-5 mt-16">
    <h2 class="text-[13px] uppercase tracking-[0.16em] text-slate-400">
      Every measured claim
    </h2>
    <div class="rule mt-4 mb-6"></div>
    {
      areas.map((a) => {
        const group = claims.filter((r) => area(r.name) === a)
        if (!group.length) return null
        return (
          <div class="mb-8">
            <h3 class="text-[13.5px] font-medium text-slate-300 mb-3">{a}</h3>
            <div class="space-y-2">
              {group.map((r) => (
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2 border-b border-ink-700/40">
                  <span
                    class={`font-mono text-[10.5px] px-1.5 py-0.5 rounded shrink-0 ${
                      r.status === 'pass'
                        ? 'bg-emerald-400/12 text-emerald-400'
                        : 'bg-rose-400/12 text-rose-400'
                    }`}
                  >
                    {r.status === 'pass' ? 'PASS' : r.status}
                  </span>
                  <span class="font-mono text-[12px] text-slate-300">{r.name}</span>
                  <span class="text-[12.5px] text-slate-400 basis-full sm:basis-auto sm:flex-1 min-w-0">
                    {r.says}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      })
    }
  </section>

  <!-- ------------------------------------------------------------- raw data -->
  <section class="mx-auto max-w-6xl px-5 mt-14">
    <div class="panel rounded-lg p-6">
      <h2 class="text-[14.5px] font-medium text-slate-300">Raw data</h2>
      <p class="mt-2 max-w-3xl text-[13px] text-slate-400">
        The files this page is built from. The site imports them at build time, so if the
        suite stops producing a figure the build breaks rather than the page going stale.
      </p>
      <div class="mt-4 flex flex-wrap gap-2.5 text-[12px]">
        {
          [
            'regression.json',
            'tool_results.json',
            'tardos.json',
            'kerning_results.json',
            'authorship_results.json',
            'envelope.json',
            'membrane.json',
            'vision_results.json',
            'video_results.json',
            'oracle_results.json',
            'sweep.json',
            'demo.json',
          ].map((f) => (
            <a
              href={`${base}/evidence/${f}`}
              class="rounded border border-ink-600/80 px-2.5 py-1 font-mono text-slate-400 hover:border-amber-400/60 hover:text-amber-400 transition-colors"
            >
              {f}
            </a>
          ))
        }
      </div>
      <p class="mt-5 text-[12.5px] text-slate-400">
        Reproduce locally:{' '}
        <code class="font-mono text-slate-300">cd cloister/tests &amp;&amp; python3 run_all.py</code>
        — about five minutes, or{' '}
        <code class="font-mono text-slate-300">--fast</code> to skip the modules that
        rasterise pages.
      </p>
    </div>
  </section>
</Base>
